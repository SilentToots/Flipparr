# the NAS media-service identity.
PUID=1000
PGID=10
TZ=America/New_York
SONICBOOM_PORT=8787

# Persistent database and locally stored API credentials.
CONFIG_PATH=/srv/docker/sonicboom

# Existing comic library and SABnzbd's completed comics category folder.
COMICS_PATH=/srv/books/comics
SAB_COMPLETE_PATH=/srv/data/downloads/usenet/complete/comics
