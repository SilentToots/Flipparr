# ---- Flipparr ----------------------------------------------------------------

# The user the container runs as. /config must be writable by it.
PUID=1000
PGID=10
TZ=America/New_York

# Where the port is published. Loopback by default; set an address on your own
# network or tailnet to reach it from another device. Turn on authentication in
# setup before publishing anywhere other people can reach.
FLIPPARR_BIND=127.0.0.1
# Port published on the host. The container always listens on 8787.
FLIPPARR_PORT=8787

# Where Flipparr keeps its database, settings and stored credentials.
# This is the only directory you need to back up.
CONFIG_PATH=/srv/docker/flipparr

# Your comic library. Mounted read-write: a completed download is imported into
# it, and replacing a file moves the original into .flipparr/quarantine/ rather
# than deleting it. Scanning only reads.
COMICS_PATH=/srv/books/comics

# Your download client's completed comics folder. Mounted read-only. Only
# needed for automatic import; leave the default if you are not using one.
SAB_COMPLETE_PATH=/srv/data/downloads/usenet/complete/comics

# How often Flipparr checks the download client for finished comics.
IMPORT_POLL_SECONDS=15
MIN_FREE_SPACE_MB=100

# --- Reverse proxy -----------------------------------------------------------
# Address of the reverse proxy in front of Flipparr, if any (Nginx Proxy
# Manager, Traefik, Caddy...). Only set this to a proxy you control.
#
# A proxy makes every request appear to come from the proxy itself. This tells
# Flipparr whose X-Forwarded-For header to believe, so the "skip sign-in on
# local addresses" option can see the real client. Leave it empty and the header
# is ignored entirely -- which is the safe default, because otherwise anyone
# could send "X-Forwarded-For: 127.0.0.1" and skip authentication.
#
# If you do not know the proxy's address, leave this empty and turn the local
# bypass off in Settings -> Security.
TRUSTED_PROXIES=


# ---- Parked V2 stack ---------------------------------------------------------
# Only needed by the parked V2 compose files (compose.v2*.yaml). Not used by
# Flipparr. Kept so those files still resolve if someone revives them.

# V2 release-candidate Compose paths. Keep V1 CONFIG_PATH separate during QA.
SONICBOOM_V2_PORT=8788
# Exact loopback origin used through the V2 QA SSH tunnel.
SONICBOOM_V2_UI_ORIGIN=http://127.0.0.1:8795
# Exact Docker bridge gateway address; do not use a subnet or wildcard.
SONICBOOM_V2_TRUSTED_CLIENTS=["192.168.16.1"]
V2_CONFIG_PATH=/srv/docker/sonicboom-v2
V2_STAGING_PATH=/srv/docker/sonicboom-v2/staging
# Provider keys (Metron, Comic Vine) and the downloader stack (Prowlarr,
# SABnzbd) are entered in the Settings screen and stored in the app's own
# /config volume. No credential files are mounted.
ACQUISITION_INTERVAL_SECONDS=10

# --- Persistent V2 QA service (docs/V2_QA_DEPLOYMENT.md) -----------------------
# Isolated state, read-only comics, reached over Tailscale Serve (tailnet-only).
# Loopback port the QA container publishes; the Serve proxy points here.
SONICBOOM_V2_QA_PORT=8790
# Exact browser origin the stable QA URL is served from. Use https:// only once
# the tailnet has HTTPS certificates enabled.
SONICBOOM_V2_QA_ORIGIN=http://<nas>.<tailnet>.ts.net
# Isolated QA state (own sqlite db + backups + reference.db). Keep separate from
# the disposable-preview V2_CONFIG_PATH above.
# V2_CONFIG_PATH / V2_STAGING_PATH are reused by the deploy script — point them
# at the QA-only dirs when deploying QA, e.g.:
#   V2_CONFIG_PATH=/srv/docker/sonicboom-v2-qa/config
#   V2_STAGING_PATH=/srv/docker/sonicboom-v2-qa/staging
# reference.db copied into the isolated /config on first deploy (path only).
SONICBOOM_V2_QA_REFERENCE_SOURCE=/srv/docker/sonicboom-v2/reference.db
