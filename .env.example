# ---- Flipparr ----------------------------------------------------------------

# The user the container runs as. /config must be writable by it.
PUID=1000
PGID=10
TZ=America/New_York

# Where the port is published. Loopback by default; set an address on your own
# network to reach it from another device. Turn on authentication in setup
# before publishing anywhere other people can reach. Not a Tailscale/VPN address:
# it does not exist yet when Docker starts at boot, so the container fails to
# start and is never retried. Use Tailscale Serve to loopback instead.
FLIPPARR_BIND=127.0.0.1
# Port published on the host. The container always listens on 8787.
FLIPPARR_PORT=8787

# Where Flipparr keeps its database, settings and stored credentials.
# This is the only directory you need to back up.
CONFIG_PATH=/path/to/flipparr/config

# Your comic library. Mounted read-write: a completed download is imported into
# it, and replacing a file moves the original into .flipparr/quarantine/ rather
# than deleting it. Scanning only reads.
COMICS_PATH=/path/to/comics

# Your download client's completed comics folder. Mounted read-only. Only
# needed for automatic import; leave the default if you are not using one.
SAB_COMPLETE_PATH=/path/to/downloads/complete/comics

# qBittorrent's comics category folder, for torrents. Mounted read-only; the
# folder's name has to be the category's ("comics"), as qBittorrent reports it.
# Only needed with qBittorrent; create the folder first so it keeps the owner
# qBittorrent writes as.
# TORRENT_COMPLETE_PATH=/path/to/qbittorrent/complete/comics

# How often Flipparr checks the download client for finished comics.
IMPORT_POLL_SECONDS=15
MIN_FREE_SPACE_MB=100

# --- Reverse proxy -----------------------------------------------------------
# Address of the reverse proxy in front of Flipparr, if any (Nginx Proxy
# Manager, Traefik, Caddy...). Only set this to a proxy you control.
#
# A proxy makes every request appear to come from the proxy itself. This tells
# Flipparr whose X-Forwarded-For header to believe, so the "skip sign-in on
# local addresses" option can see the real client. Leave it empty and the header
# is ignored entirely -- which is the safe default, because otherwise anyone
# could send "X-Forwarded-For: 127.0.0.1" and skip authentication.
#
# Comma-separated addresses or networks (CIDR). If the proxy is a container,
# give the Docker network's subnet, not the container's address: Docker hands
# those out in start order, so the proxy's address changes across restarts.
#   docker network inspect -f '{{range .IPAM.Config}}{{.Subnet}}{{end}}' <network>
# Every container on that network is then trusted as a proxy, so keep the
# network to the proxy and the apps behind it.
#
# If you do not know the proxy's address, leave this empty and turn the local
# bypass off in Settings -> Security.
TRUSTED_PROXIES=
