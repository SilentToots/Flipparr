# the NAS media-service identity.
PUID=1000
PGID=10
TZ=America/New_York
SONICBOOM_PORT=8787

# Persistent database and locally stored API credentials.
CONFIG_PATH=/srv/docker/sonicboom

# Existing comic library and SABnzbd's completed comics category folder.
COMICS_PATH=/srv/books/comics
SAB_COMPLETE_PATH=/srv/data/downloads/usenet/complete/comics

# How often SonicBoom checks SABnzbd history for completed comic downloads.
IMPORT_POLL_SECONDS=15
MIN_FREE_SPACE_MB=100

# V2 release-candidate Compose paths. Keep V1 CONFIG_PATH separate during QA.
SONICBOOM_V2_PORT=8788
# Exact loopback origin used through the V2 QA SSH tunnel.
SONICBOOM_V2_UI_ORIGIN=http://127.0.0.1:8795
# Exact Docker bridge gateway address; do not use a subnet or wildcard.
SONICBOOM_V2_TRUSTED_CLIENTS=["192.168.16.1"]
V2_CONFIG_PATH=/srv/docker/sonicboom-v2
V2_STAGING_PATH=/srv/docker/sonicboom-v2/staging
# Path only; never place the credential value in this env file.
ACQUISITION_CONFIG_PATH=/srv/docker/sonicboom/acquisition-services.json
# Private provider configuration mounted read-only for bounded metadata discovery.
# Keep the actual Metron token and Comic Vine API key out of this env file.
METADATA_CONFIG_PATH=/srv/docker/sonicboom/metadata-providers.json
ACQUISITION_INTERVAL_SECONDS=10

# --- Persistent V2 QA service (docs/V2_QA_DEPLOYMENT.md) -----------------------
# Isolated state, read-only comics, reached over Tailscale Serve (tailnet-only).
# Loopback port the QA container publishes; the Serve proxy points here.
SONICBOOM_V2_QA_PORT=8790
# Exact browser origin the stable QA URL is served from. Use https:// only once
# the tailnet has HTTPS certificates enabled.
SONICBOOM_V2_QA_ORIGIN=http://<nas>.<tailnet>.ts.net
# Isolated QA state (own sqlite db + backups + reference.db). Keep separate from
# the disposable-preview V2_CONFIG_PATH above.
# V2_CONFIG_PATH / V2_STAGING_PATH are reused by the deploy script — point them
# at the QA-only dirs when deploying QA, e.g.:
#   V2_CONFIG_PATH=/srv/docker/sonicboom-v2-qa/config
#   V2_STAGING_PATH=/srv/docker/sonicboom-v2-qa/staging
# reference.db copied into the isolated /config on first deploy (path only).
SONICBOOM_V2_QA_REFERENCE_SOURCE=/srv/docker/sonicboom-v2/reference.db
